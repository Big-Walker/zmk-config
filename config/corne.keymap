#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        sticky_shift_caps_word: sticky_shift_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "STICKY_SHIFT_CAPS_WORD";
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_sscw: layer_sscw {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_SSCW";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        thirdlayer: thirdlayer {
            compatible = "zmk,behavior-tap-dance";
            label = "THIRDLAYER";
            #binding-cells = <0>;
            bindings = <&lt 4 PERIOD>, <&kp NON_US_BACKSLASH>;
        };

        home_row: hr {
            compatible = "zmk,behavior-hold-tap";
            label = "hr";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp Q                 &kp W                 &kp F                   &kp P                   &kp B          &kp J             &kp L                   &kp U                       &kp Y                 &mt LS(NUMBER_2) APOS      &kp BSPC
&kp ESCAPE  &home_row LEFT_WIN A  &home_row LEFT_ALT R  &home_row LCTRL S       &home_row LEFT_SHIFT T  &mt EQUAL G    &kp M             &home_row LEFT_SHIFT N  &home_row RCTRL E           &home_row LEFT_ALT I  &home_row RIGHT_WIN O      &kp DELETE
&kp TAB     &kp Z                 &kp X                 &kp C                   &kp D                   &kp V          &kp K             &kp H                   &kp COMMA                   &kp DOT               &mt NON_US_BACKSLASH FSLH  &kp RET
                                                        &lt 1 LEFT_PARENTHESIS  &lt 2 LEFT_SHIFT        &thirdlayer    &mt SLASH PERIOD  &lt 3 SPACE             &mt RALT RIGHT_PARENTHESIS
            >;
        };

        Number {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans       &kp MINUS         &kp N7           &kp N8        &kp N9        &kp SLASH     &trans
&trans  &kp LC(A)  &trans     &kp LC(S)  &trans     &trans       &mt PLUS EQUAL    &mt F4 NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(D)  &kp LC(V)    &mt COLON PERIOD  &kp NUMBER_1     &kp NUMBER_2  &kp N3        &trans        &trans
                              &trans     &trans     &trans       &kp PERIOD        &kp SPACE        &kp N0
            >;
        };

        Navigation {
            bindings = <
&trans  &trans     &trans                &trans                 &trans                  &trans           &kp PG_UP      &kp HOME  &trans    &trans     &trans  &trans
&trans  &kp LC(A)  &home_row LEFT_ALT R  &home_row LCTRL LC(S)  &home_row LEFT_SHIFT T  &trans           &trans         &kp LEFT  &kp UP    &kp RIGHT  &trans  &trans
&trans  &kp LC(Z)  &kp LC(X)             &kp LC(C)              &kp LC(D)               &kp LC(LS(V))    &kp PAGE_DOWN  &kp END   &kp DOWN  &trans     &trans  &trans
                                         &trans                 &trans                  &trans           &trans         &trans    &trans
            >;
        };

        Symbols {
            bindings = <
&trans  &trans         &kp LS(NUMBER_3)   &trans          &kp EXCLAMATION  &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DOLLAR       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LESS_THAN  &kp GREATER_THAN   &kp LBKT        &kp RBKT         &kp LS(QMARK)    &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans          &kp AMPERSAND    &trans           &trans  &trans  &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &trans   &kp F7   &kp F8   &kp F9  &trans  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans   &kp F4   &kp F5   &kp F6  &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans   &kp F1   &kp F2   &kp F3  &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp F12  &kp F11  &kp F10
            >;
        };
    };
};
